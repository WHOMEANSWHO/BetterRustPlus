# Copy to .env with mode 600, then generate a fresh random key before starting.
# Do not use this placeholder as an ingest key.
BETTERRUSTPLUS_INGEST_KEY=
Alerts__DryRun=true
Alerts__AllowedServerIds__0=our-server

# Separate death rule means each accepted death is reported, without a cooldown.
Alerts__Rules__0__Id=team-deaths
Alerts__Rules__0__Kinds__0=teammate-death
Alerts__Rules__0__CooldownSeconds=0
Alerts__Rules__0__Target=primary
Alerts__Rules__0__MentionEveryone=false

Alerts__Rules__1__Id=raid-alarm
Alerts__Rules__1__Kinds__0=raid
Alerts__Rules__1__CooldownSeconds=60
Alerts__Rules__1__Target=primary
Alerts__Rules__1__MentionEveryone=false

Alerts__Rules__2__Id=world-events
Alerts__Rules__2__Kinds__0=cargo
Alerts__Rules__2__Kinds__1=airdrop
Alerts__Rules__2__Kinds__2=deepsea
Alerts__Rules__2__CooldownSeconds=60
Alerts__Rules__2__Target=primary
Alerts__Rules__2__MentionEveryone=false

# Uncomment only when ready to configure actual delivery. Keep DryRun=true first.
# Alerts__Targets__primary__WebhookUrl=https://discord.com/api/webhooks/ID/TOKEN

# Optional paired-server source. Leave disabled until the server/account fields
# are copied from your own valid pairing. These values are private credentials.
RustSource__Enabled=false
# RustSource__ServerId=our-server
# RustSource__Host=rust-server-host
# RustSource__Port=28082
# RustSource__SteamId=YOUR_STEAM_ID
# RustSource__PlayerToken=YOUR_PLAYER_TOKEN
# RustSource__CompanionServerId=YOUR_COMPANION_SERVER_ID
# RustSource__AuthToken=YOUR_COMPANION_AUTH_TOKEN
# RustSource__AlarmEntityIds__0=YOUR_PAIRED_SMART_ALARM_ENTITY_ID
# RustSource__PollSeconds=15

# Optional interactive bot. The bot token is distinct from a Discord webhook.
DiscordBot__Enabled=false
# DiscordBot__Token=YOUR_PRIVATE_BOT_TOKEN
# DiscordBot__GuildId=YOUR_DISCORD_SERVER_ID
# DiscordBot__AllowedChannelIds__0=YOUR_COMMAND_CHANNEL_ID
# To use the bot for event delivery, also allowlist the alert text channel and
# select this route INSTEAD OF the webhook URL for primary, then review DryRun:
# DiscordBot__AllowedChannelIds__1=YOUR_ALERT_CHANNEL_ID
# Alerts__Targets__primary__DiscordChannelId=YOUR_ALERT_CHANNEL_ID
